# IndiaClaimGuard — Environment Variables
# Copy this file to .env and fill in your keys

# Adaption API Key — get from adaptionlabs.ai/app/settings > API Keys
ADAPTION_API_KEY=pt_live_YOUR_KEY_HERE

# Adaption Dataset ID — set automatically after first upload
ADAPTION_DATASET_ID=

# Kaggle Credentials — get from kaggle.com > Account > Create API Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
